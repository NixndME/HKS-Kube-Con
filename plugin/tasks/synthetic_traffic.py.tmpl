#!/usr/bin/env python3
# Turn a steady trickle of real HTTP requests at the K8s Showcase app on or
# off. Exists so the dashboards (Grafana graphs, the app's own visitor log,
# the Morpheus widget) show real moving data on a quiet booth network instead
# of a flat line -- every request is real traffic hitting the real Service,
# not a fabricated metric.
#
# Nothing here is a fixed value for one appliance, same dynamic cluster/master
# lookup as every other task in this plugin.

import json
import os
import pty
import select
import ssl
import sys
import time
import urllib.request

APPLIANCE_URL = "<%= morpheus.applianceUrl %>"
API_TOKEN = "<%= morpheus.apiAccessToken %>"
SSH_USER = json.loads(r'''<%= cypher.read('secret/hks-showcase-ssh-user') %>''')["data"]
SSH_PASS = json.loads(r'''<%= cypher.read('secret/hks-showcase-ssh-password') %>''')["data"]

CLUSTER_NAME = "<%= customOptions.clusterName %>"
ENABLED = "<%= customOptions.enabled %>"
INTERVAL_SECONDS = "<%= customOptions.intervalSeconds %>"

NAMESPACE = "k8s-showcase"
KUBECONFIG = "/etc/kubernetes/admin.conf"
NAME = "k8s-showcase-traffic-gen"
CTX = ssl._create_unverified_context()


def api_get(path):
    req = urllib.request.Request(f"{APPLIANCE_URL}{path}", headers={
        "Authorization": f"Bearer {API_TOKEN}", "Accept": "application/json"})
    with urllib.request.urlopen(req, context=CTX, timeout=25) as r:
        return json.loads(r.read().decode())


def pick_cluster():
    clusters = api_get("/api/clusters?max=100").get("clusters", [])
    k8s = [c for c in clusters
           if "kubernetes" in (c.get("layout") or {}).get("name", "").lower()
           or c.get("type") == "kubernetes"]
    if not k8s:
        sys.exit("FATAL: no Kubernetes cluster found on this Morpheus.")
    if CLUSTER_NAME and CLUSTER_NAME.lower() != "null":
        for c in k8s:
            if c["name"] == CLUSTER_NAME:
                return c
        sys.exit(f"FATAL: no Kubernetes cluster named {CLUSTER_NAME!r} found.")
    if len(k8s) > 1:
        names = ", ".join(c["name"] for c in k8s)
        sys.exit(f"FATAL: more than one Kubernetes cluster exists ({names}). "
                 f"Run again and pick one in the Cluster Name field.")
    return k8s[0]


def master_ssh_host(cluster):
    for s in cluster.get("servers", []):
        if (s.get("computeServerType") or {}).get("nodeType") == "kube-master":
            detail = api_get(f"/api/servers/{s['id']}").get("server", {})
            return detail.get("sshHost"), detail.get("sshPort") or 22
    sys.exit("FATAL: could not find a master node for this cluster.")


def ssh_run(host, port, remote_cmd, stdin_data=None, timeout=30):
    cmd = ["ssh", "-p", str(port), "-o", "StrictHostKeyChecking=no",
           "-o", "PubkeyAuthentication=no", "-o", "PreferredAuthentications=password",
           "-o", "ConnectTimeout=10", f"{SSH_USER}@{host}", remote_cmd]
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp(cmd[0], cmd)
        os._exit(1)
    output = b""
    sent_password = False
    sent_stdin = stdin_data is None
    start = time.time()
    while time.time() - start < timeout:
        r, _, _ = select.select([fd], [], [], 1)
        if fd in r:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                break
            if not chunk:
                break
            output += chunk
            if not sent_password and b"assword:" in chunk:
                os.write(fd, (SSH_PASS + "\n").encode())
                sent_password = True
            elif sent_password and not sent_stdin:
                os.write(fd, stdin_data.encode())
                os.write(fd, b"\x04")
                sent_stdin = True
        else:
            try:
                done, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                break
            if done != 0:
                return output.decode(errors="replace"), status
    import signal
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        _, status = os.waitpid(pid, 0)
    except ChildProcessError:
        status = 0
    return output.decode(errors="replace"), status


def exit_code_of(raw):
    return os.WEXITSTATUS(raw) if os.WIFEXITED(raw) else raw


def kubectl(host, port, args, stdin_data=None):
    out, status = ssh_run(host, port, f"sudo kubectl --kubeconfig={KUBECONFIG} {args}", stdin_data)
    return out.strip(), exit_code_of(status)


def build_manifest(interval_seconds):
    return f"""
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {NAME}
  namespace: {NAMESPACE}
  labels:
    app: {NAME}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {NAME}
  template:
    metadata:
      labels:
        app: {NAME}
    spec:
      containers:
        - name: traffic-gen
          image: curlimages/curl:8.10.1
          command: ["sh", "-c", "while true; do curl -s -o /dev/null http://k8s-showcase.{NAMESPACE}.svc/ || true; sleep {interval_seconds}; done"]
          resources:
            requests: {{cpu: 5m, memory: 16Mi}}
            limits: {{cpu: 50m, memory: 32Mi}}
"""


def main():
    cluster = pick_cluster()
    print(f"using cluster: {cluster['name']}")
    host, port = master_ssh_host(cluster)

    enabled = (ENABLED or "").strip().lower() in ("true", "yes", "1")
    if not enabled:
        out, code = kubectl(host, port, f"delete deployment {NAME} -n {NAMESPACE} --ignore-not-found")
        print(out)
        print("Synthetic traffic generator: stopped (not running).")
        return

    interval = INTERVAL_SECONDS.strip() if INTERVAL_SECONDS and INTERVAL_SECONDS.lower() != "null" else "5"
    if not interval.isdigit() or int(interval) < 1:
        interval = "5"

    out, code = kubectl(host, port, "get namespace k8s-showcase")
    if code != 0:
        sys.exit("FATAL: k8s-showcase namespace does not exist yet. "
                 "Order 'Deploy K8s Showcase App' first.")

    apply_cmd = (f"cat > /tmp/traffic-gen.yaml && "
                 f"sudo kubectl --kubeconfig={KUBECONFIG} apply -f /tmp/traffic-gen.yaml")
    out, status = ssh_run(host, port, apply_cmd, stdin_data=build_manifest(interval))
    print(out)
    if exit_code_of(status) != 0:
        sys.exit(f"FATAL: kubectl apply failed, exit code {exit_code_of(status)}")
    print(f"Synthetic traffic generator: running, one request every {interval}s against the live app.")


if __name__ == "__main__":
    main()
