#!/usr/bin/env python3
# Roll back to whichever color isn't live right now. Unlike "Switch K8s
# Showcase Traffic" (which refuses if the target slot is scaled to 0, telling
# you to re-deploy it by hand first), this reads the target's existing
# Deployment spec directly -- its image tag is still there even at 0
# replicas -- scales it back up automatically, then switches. One order
# instead of two.
#
# Nothing here is a fixed value for one appliance, same dynamic cluster/master
# lookup as every other task in this plugin.

import json
import os
import pty
import select
import ssl
import sys
import time
import urllib.request

APPLIANCE_URL = "<%= morpheus.applianceUrl %>"
API_TOKEN = "<%= morpheus.apiAccessToken %>"
SSH_USER = json.loads(r'''<%= cypher.read('secret/hks-showcase-ssh-user') %>''')["data"]
SSH_PASS = json.loads(r'''<%= cypher.read('secret/hks-showcase-ssh-password') %>''')["data"]

CLUSTER_NAME = "<%= customOptions.clusterName %>"
NAMESPACE = "k8s-showcase"
KUBECONFIG = "/etc/kubernetes/admin.conf"
CTX = ssl._create_unverified_context()

# Optional: see the matching comment in deploy_k8s_showcase.py.tmpl. Left
# blank by default so this works on any HKS/MKS cluster out of the box.
PUBLIC_APP_URL = ""


def api_get(path):
    req = urllib.request.Request(f"{APPLIANCE_URL}{path}", headers={
        "Authorization": f"Bearer {API_TOKEN}", "Accept": "application/json"})
    with urllib.request.urlopen(req, context=CTX, timeout=25) as r:
        return json.loads(r.read().decode())


def pick_cluster():
    clusters = api_get("/api/clusters?max=100").get("clusters", [])
    k8s_clusters = [c for c in clusters
                    if "kubernetes" in (c.get("layout") or {}).get("name", "").lower()
                    or c.get("type") == "kubernetes"]
    if not k8s_clusters:
        sys.exit("FATAL: no Kubernetes cluster found on this Morpheus. Create or onboard one first.")
    if CLUSTER_NAME and CLUSTER_NAME.lower() != "null":
        for c in k8s_clusters:
            if c["name"] == CLUSTER_NAME:
                return c
        sys.exit(f"FATAL: no Kubernetes cluster named {CLUSTER_NAME!r} found.")
    if len(k8s_clusters) > 1:
        names = ", ".join(c["name"] for c in k8s_clusters)
        sys.exit(f"FATAL: more than one Kubernetes cluster exists ({names}). "
                 f"Order again and pick one in the Cluster Name field.")
    return k8s_clusters[0]


def master_ssh_host(cluster):
    for s in cluster.get("servers", []):
        node_type = (s.get("computeServerType") or {}).get("nodeType", "")
        if node_type == "kube-master":
            detail = api_get(f"/api/servers/{s['id']}").get("server", {})
            return detail.get("sshHost"), detail.get("sshPort") or 22
    sys.exit("FATAL: could not find a master node for this cluster.")


def ssh_run(host, port, remote_cmd, timeout=60):
    cmd = ["ssh", "-p", str(port), "-o", "StrictHostKeyChecking=no",
           "-o", "PubkeyAuthentication=no", "-o", "PreferredAuthentications=password",
           "-o", "ConnectTimeout=10", f"{SSH_USER}@{host}", remote_cmd]
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp(cmd[0], cmd)
        os._exit(1)
    output = b""
    sent_password = False
    start = time.time()
    while time.time() - start < timeout:
        r, _, _ = select.select([fd], [], [], 1)
        if fd in r:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                break
            if not chunk:
                break
            output += chunk
            if not sent_password and b"assword:" in chunk:
                os.write(fd, (SSH_PASS + "\n").encode())
                sent_password = True
        else:
            try:
                done, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                break
            if done != 0:
                return output.decode(errors="replace"), status
    import signal
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        _, status = os.waitpid(pid, 0)
    except ChildProcessError:
        status = 0
    return output.decode(errors="replace"), status


def exit_code_of(raw_status):
    return os.WEXITSTATUS(raw_status) if os.WIFEXITED(raw_status) else raw_status


def run_kubectl(host, port, args):
    cmd = f"sudo kubectl --kubeconfig={KUBECONFIG} {args}"
    out, status = ssh_run(host, port, cmd)
    return out.strip(), exit_code_of(status)


def find_demo_url(host, port):
    out, code = run_kubectl(host, port,
        "get svc -n ingress-nginx ingress-nginx-controller "
        "-o jsonpath='{.spec.ports[?(@.port==80)].nodePort}'")
    node_port = out.splitlines()[-1].strip() if out else ""
    if code != 0 or not node_port.isdigit():
        return None
    out2, code2 = run_kubectl(host, port,
        "get pods -n ingress-nginx -l app.kubernetes.io/component=controller "
        "-o jsonpath='{.items[0].status.hostIP}'")
    node_ip = out2.splitlines()[-1].strip() if out2 else ""
    target = node_ip if (code2 == 0 and node_ip) else host
    return PUBLIC_APP_URL or f"http://{target}:{node_port}/"


def main():
    cluster = pick_cluster()
    print(f"using cluster: {cluster['name']}")
    host, port = master_ssh_host(cluster)
    print(f"master node: {host}:{port}")

    live, code = run_kubectl(host, port,
        f"get svc k8s-showcase -n {NAMESPACE} -o jsonpath='{{.spec.selector.slot}}'")
    if code != 0:
        sys.exit("FATAL: no k8s-showcase Service found. Order 'Deploy K8s Showcase App' first.")
    live = live.splitlines()[-1].strip() if live else ""
    if live not in ("blue", "green"):
        sys.exit(f"FATAL: could not read the current live slot (got {live!r}).")

    target = "green" if live == "blue" else "blue"
    print(f"currently live: {live!r}. Rolling back to: {target!r}.")

    out, code = run_kubectl(host, port, f"get deployment k8s-showcase-{target} -n {NAMESPACE} -o json")
    if code != 0:
        sys.exit(f"FATAL: slot {target!r} has never been deployed on this cluster -- "
                 f"there is nothing to roll back to. Order 'Deploy K8s Showcase App' "
                 f"with color={target!r} instead.")
    try:
        start = out.index("{")
        dep = json.loads(out[start:])
    except (ValueError, json.JSONDecodeError):
        sys.exit(f"FATAL: could not read slot {target!r}'s deployment to roll back to.")

    containers = dep.get("spec", {}).get("template", {}).get("spec", {}).get("containers", [{}])
    image = containers[0].get("image", "") if containers else "unknown"
    current_replicas = dep.get("spec", {}).get("replicas", 0) or 0

    if current_replicas < 1:
        live_replicas, _ = run_kubectl(host, port,
            f"get deployment k8s-showcase-{live} -n {NAMESPACE} -o jsonpath='{{.spec.replicas}}'")
        # run_kubectl's output still has the SSH session's own preamble (host-key
        # warning, password-prompt echo) ahead of the real value on its own last
        # line -- confirmed live that skipping .splitlines()[-1] here made
        # .isdigit() fail on the whole multi-line blob and silently fall back to
        # the hardcoded "2" instead of the real replica count, scaling the
        # rolled-back slot to the wrong size.
        live_replicas = live_replicas.splitlines()[-1].strip() if live_replicas.strip() else ""
        live_replicas = live_replicas if live_replicas.isdigit() else "2"
        print(f"slot {target!r} is scaled to 0 -- scaling it back up to {live_replicas} "
              f"replica(s) before switching (image: {image})")
        _, scale_code = run_kubectl(host, port,
            f"scale deployment k8s-showcase-{target} -n {NAMESPACE} --replicas={live_replicas}")
        if scale_code != 0:
            sys.exit(f"FATAL: could not scale slot {target!r} back up.")

        # Confirmed live: a scale-up from 0 on this cluster can take noticeably
        # longer than the readinessProbe's own timing alone would suggest
        # (scheduling, image-pull check, and the SSH round-trip this polling
        # itself takes), occasionally landing just past 90s even for a pod
        # that was never actually broken. 150s gives real headroom before
        # refusing to switch, without weakening the actual safety check.
        deadline = time.time() + 150
        ready = "0"
        while time.time() < deadline:
            raw, _ = run_kubectl(host, port,
                f"get deployment k8s-showcase-{target} -n {NAMESPACE} "
                f"-o jsonpath='{{.status.readyReplicas}}'")
            # Same fix as live_replicas above: take the real value off the last
            # line, not the whole SSH-preamble-plus-value blob -- confirmed live
            # that skipping this made ready permanently read as "0" every single
            # poll, so this loop always burned the full deadline and always
            # failed, even when the pods were already healthy within seconds.
            raw = raw.splitlines()[-1].strip() if raw.strip() else ""
            ready = raw if raw.isdigit() else "0"
            if ready == live_replicas:
                break
            time.sleep(5)
        print(f"slot {target!r}: {ready}/{live_replicas} ready after scale-up.")
        if ready != live_replicas:
            sys.exit(f"FATAL: slot {target!r} did not become ready within 150s of scaling up "
                     f"(got {ready}/{live_replicas}) -- refusing to switch traffic to it. "
                     f"Check the pods ({image}) before trying again.")
    else:
        print(f"slot {target!r} is already running {current_replicas} replica(s) (image: {image}).")

    patch = '{"spec":{"selector":{"slot":"%s"}}}' % target
    out, code = run_kubectl(host, port, f"patch svc k8s-showcase -n {NAMESPACE} -p '{patch}'")
    print(out)
    if code != 0:
        sys.exit(f"FATAL: switching traffic failed, exit code {code}")
    print(f"Rolled back: traffic is now live on slot {target!r} (image: {image}).")

    _, scale_code = run_kubectl(host, port,
        f"scale deployment k8s-showcase-{live} -n {NAMESPACE} --replicas=0")
    if scale_code == 0:
        print(f"Scaled down the previous slot ({live!r}) to 0 replicas.")

    url = find_demo_url(host, port)
    if url:
        print(f"Open it here: {url}")


if __name__ == "__main__":
    main()
