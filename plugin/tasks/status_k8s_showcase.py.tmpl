#!/usr/bin/env python3
# Print a plain status report for the K8s Showcase app: which cluster, which
# color is live, each color's version and ready pod count, and the URL to
# open it. Read only - changes nothing.
#
# Nothing here is a fixed value for one appliance. Same cluster/master lookup
# and SSH technique as the deploy and switch tasks.

import json
import os
import pty
import select
import ssl
import sys
import time
import urllib.request

APPLIANCE_URL = "<%= morpheus.applianceUrl %>"
API_TOKEN = "<%= morpheus.apiAccessToken %>"
SSH_USER = json.loads(r'''<%= cypher.read('secret/hks-showcase-ssh-user') %>''')["data"]
SSH_PASS = json.loads(r'''<%= cypher.read('secret/hks-showcase-ssh-password') %>''')["data"]

CLUSTER_NAME = "<%= customOptions.clusterName %>"
NAMESPACE = "k8s-showcase"
KUBECONFIG = "/etc/kubernetes/admin.conf"

# Optional: see the matching comment in deploy_k8s_showcase.py.tmpl. Left
# blank by default so this works on any HKS/MKS cluster out of the box.
PUBLIC_APP_URL = ""
CTX = ssl._create_unverified_context()


def api_get(path):
    req = urllib.request.Request(f"{APPLIANCE_URL}{path}", headers={
        "Authorization": f"Bearer {API_TOKEN}", "Accept": "application/json"})
    with urllib.request.urlopen(req, context=CTX, timeout=15) as r:
        return json.loads(r.read().decode())


def pick_cluster():
    clusters = api_get("/api/clusters?max=100").get("clusters", [])
    k8s = [c for c in clusters
           if "kubernetes" in (c.get("layout") or {}).get("name", "").lower()
           or c.get("type") == "kubernetes"]
    if not k8s:
        sys.exit("FATAL: no Kubernetes cluster found on this Morpheus.")
    if CLUSTER_NAME and CLUSTER_NAME.lower() != "null":
        for c in k8s:
            if c["name"] == CLUSTER_NAME:
                return c
        sys.exit(f"FATAL: no Kubernetes cluster named {CLUSTER_NAME!r} found.")
    if len(k8s) > 1:
        names = ", ".join(c["name"] for c in k8s)
        sys.exit(f"FATAL: more than one Kubernetes cluster exists ({names}). "
                 f"Run again and pick one in the Cluster Name field.")
    return k8s[0]


def master_ssh_host(cluster):
    for s in cluster.get("servers", []):
        if (s.get("computeServerType") or {}).get("nodeType") == "kube-master":
            detail = api_get(f"/api/servers/{s['id']}").get("server", {})
            return detail.get("sshHost"), detail.get("sshPort") or 22
    sys.exit("FATAL: could not find a master node for this cluster.")


def ssh_run(host, port, remote_cmd, timeout=20):
    cmd = ["ssh", "-p", str(port), "-o", "StrictHostKeyChecking=no",
           "-o", "PubkeyAuthentication=no", "-o", "PreferredAuthentications=password",
           "-o", "ConnectTimeout=8", f"{SSH_USER}@{host}", remote_cmd]
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp(cmd[0], cmd)
        os._exit(1)
    output = b""
    sent = False
    start = time.time()
    while time.time() - start < timeout:
        r, _, _ = select.select([fd], [], [], 1)
        if fd in r:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                break
            if not chunk:
                break
            output += chunk
            if not sent and b"assword:" in chunk:
                os.write(fd, (SSH_PASS + "\n").encode())
                sent = True
        else:
            try:
                done, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                break
            if done != 0:
                return output.decode(errors="replace"), status
    # Loop above only stops reading on timeout, it doesn't stop the remote
    # command -- a genuinely hung remote command would make a plain blocking
    # waitpid here hang forever too. Force it.
    import signal
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        _, status = os.waitpid(pid, 0)
    except ChildProcessError:
        status = 0
    return output.decode(errors="replace"), status


def exit_code_of(raw):
    return os.WEXITSTATUS(raw) if os.WIFEXITED(raw) else raw


def kubectl(host, port, args):
    out, status = ssh_run(host, port, f"sudo kubectl --kubeconfig={KUBECONFIG} {args}")
    return out.strip(), exit_code_of(status)


def main():
    cluster = pick_cluster()
    host, port = master_ssh_host(cluster)

    live, code = kubectl(host, port,
        f"get svc k8s-showcase -n {NAMESPACE} -o jsonpath='{{.spec.selector.slot}}'")
    if code != 0:
        sys.exit(f"K8s Showcase App is not deployed yet on cluster {cluster['name']!r}. "
                  "Order 'Deploy K8s Showcase App' first.")
    live = live.splitlines()[-1].strip() if live else None

    print("=" * 50)
    print(f"K8s Showcase App - cluster: {cluster['name']}")
    print("=" * 50)

    for color in ("blue", "green"):
        out, code = kubectl(host, port, f"get deployment k8s-showcase-{color} -n {NAMESPACE} -o json")
        marker = " <-- LIVE" if color == live else ""
        if code != 0:
            print(f"{color.upper():6} not deployed{marker}")
            continue
        try:
            start = out.index("{")
            dep = json.loads(out[start:])
        except (ValueError, json.JSONDecodeError):
            print(f"{color.upper():6} could not read status{marker}")
            continue
        containers = dep.get("spec", {}).get("template", {}).get("spec", {}).get("containers", [{}])
        image = containers[0].get("image", "") if containers else ""
        version = image.split(":")[-1] if ":" in image else image
        status = dep.get("status", {})
        ready = status.get("readyReplicas", 0) or 0
        desired = dep.get("spec", {}).get("replicas", 0) or 0
        print(f"{color.upper():6} version {version:10} {ready}/{desired} pods ready{marker}")

    print("-" * 50)
    out, code = kubectl(host, port,
        "get svc -n ingress-nginx ingress-nginx-controller "
        "-o jsonpath='{.spec.ports[?(@.port==80)].nodePort}'")
    node_port = out.splitlines()[-1].strip() if out.strip() else ""
    if code == 0 and node_port.isdigit():
        out2, code2 = kubectl(host, port,
            "get pods -n ingress-nginx -l app.kubernetes.io/component=controller "
            "-o jsonpath='{.items[0].status.hostIP}'")
        node_ip = out2.splitlines()[-1].strip() if out2.strip() else ""
        target = node_ip if (code2 == 0 and node_ip) else host
        print(f"Open it here: {PUBLIC_APP_URL or f'http://{target}:{node_port}/'}")
    print("=" * 50)


if __name__ == "__main__":
    main()
